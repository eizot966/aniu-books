/epubs/*.epub
  Content-Type: application/epub+zip
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/opds.xml
  Content-Type: application/atom+xml;profile=opds-catalog;charset=utf-8
  Access-Control-Allow-Origin: *

/data/*.json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
